---
# Plantilla de la imagen para redes sociales (1200×630). Solo existe con `npm start`;
# scripts/tarjetas.sh le saca una captura por modo y las deja en public/img/.
permalink: /tarjeta/
layout: false
draft: true
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="es" data-modo="{{ metadata.modo }}" data-modo-sitio="{{ metadata.modo }}">
<head>
	<meta charset="utf-8">
	<script eleventy:ignore>{% include "modo-inicio.js" %}</script>
	<style eleventy:ignore>
		{% include "css/fonts.css" %}
		{% include "css/index.css" %}
		html, body { width: 1200px; height: 630px; overflow: hidden; }
		body { padding: 0; margin: 0; transition: none; }
		.tarjeta {
			box-sizing: border-box;
			width: 1200px;
			height: 630px;
			padding: 80px 96px;
			display: grid;
			grid-template-rows: auto auto 1fr auto;
			gap: 28px;
		}
		.tarjeta .marca { font-size: 96px; pointer-events: none; }
		.tarjeta .ondas { height: 20px; background-size: 40px 20px; margin: 0; }
		.tarjeta .lema { font-size: 40px; line-height: 1.35; max-width: 900px; align-self: center; }
		.tarjeta .pie-tarjeta { display: flex; justify-content: space-between; align-items: center; font-family: var(--f-display); font-weight: 700; font-size: 28px; }
		.tarjeta .sticker { font-size: 28px; vertical-align: 0; }
	</style>
</head>
<body>
	<div class="tarjeta">
		{% include "marca.njk" %}
		<div class="ondas"></div>
		<p class="lema">{{ metadata.description }}</p>
		<div class="pie-tarjeta">
			<span>blog.noquierouser.com</span>
			<span class="sticker">blog</span>
		</div>
	</div>
</body>
</html>
